{
  "entryPoints": ["src/log2trace.ts", "src/core/index.ts"],
  "out": "docs",
  "name": "log2trace-ui",
  "includeVersion": true,
  "readme": "README.md",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "searchInComments": true,
