{
  "name": "log2trace-viewer",
  "version": "1.0.0",
  "description": "An interactive visualization library for OpenTelemetry trace data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && node esbuild.config.js",
    "check": "tsc --noEmit",
    "demo:kill": "npx kill-port 3000",
    "demo": "npm run demo:kill && npm run build && node demo/server.js"
  },
  "keywords": [
    "opentelemetry",
    "trace",
    "visualization",
    "observability",
    "distributed-tracing",
    "waterfall",
    "timeline"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "lightningcss": "^1.31.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src"
  ]
}
